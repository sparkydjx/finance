{
  "name": "Finance PWA",
  "short_name": "Finance",
  "description": "A lightweight finance tracker that works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Finance PWA desktop view"
    },
    {
      "src": "./screenshots/mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "label": "Finance PWA mobile view"
    }
  ]
}
